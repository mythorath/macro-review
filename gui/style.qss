QWidget {
    background-color: #f3efe6;
    color: #1c1a17;
    font-family: "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #ebe4d8;
}

#Sidebar {
    background-color: #1f2a2e;
    border: none;
    min-width: 180px;
    max-width: 200px;
    padding: 12px 8px;
}

#Sidebar QPushButton {
    background-color: transparent;
    color: #d7e0e2;
    border: none;
    text-align: left;
    padding: 10px 14px;
    border-radius: 4px;
    font-size: 14px;
}

#Sidebar QPushButton:hover {
    background-color: #2c3b40;
}

#Sidebar QPushButton:checked {
    background-color: #3d6b6e;
    color: #f7f3ea;
    font-weight: 600;
}

#BrandLabel {
    color: #f7f3ea;
    font-size: 16px;
    font-weight: 700;
    padding: 8px 14px 18px 14px;
    letter-spacing: 0.5px;
}

#ContentHost {
    background-color: #f3efe6;
}

QGroupBox {
    font-weight: 600;
    border: 1px solid #cfc4b4;
    border-radius: 6px;
    margin-top: 12px;
    padding: 12px 10px 10px 10px;
    background-color: #faf7f1;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QPushButton {
    background-color: #3d6b6e;
    color: #f7f3ea;
    border: none;
    border-radius: 4px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #4a7f82;
}

QPushButton:disabled {
    background-color: #b7aea1;
    color: #efe9df;
}

QPushButton#SecondaryButton {
    background-color: transparent;
    color: #1f2a2e;
    border: 1px solid #a89882;
}

QPushButton#SecondaryButton:hover {
    background-color: #e7dfd1;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #fffdf8;
    border: 1px solid #cfc4b4;
    border-radius: 4px;
    padding: 6px 8px;
    selection-background-color: #3d6b6e;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #3d6b6e;
}

QCheckBox {
    spacing: 6px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #a89882;
    border-radius: 3px;
    background-color: #fffdf8;
}

QCheckBox::indicator:hover {
    border-color: #3d6b6e;
}

QCheckBox::indicator:checked {
    background-color: #3d6b6e;
    border-color: #2c5255;
}

QToolTip {
    background-color: #1f2a2e;
    color: #f7f3ea;
    border: 1px solid #2c3b40;
    padding: 4px 8px;
    border-radius: 4px;
}

QPlainTextEdit {
    background-color: #1f2a2e;
    color: #d7e0e2;
    border: 1px solid #2c3b40;
    border-radius: 4px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
}

QProgressBar {
    border: 1px solid #cfc4b4;
    border-radius: 4px;
    background-color: #e7dfd1;
    text-align: center;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #3d6b6e;
    border-radius: 3px;
}

QLabel#PageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #1c1a17;
}

QLabel#PageSubtitle {
    color: #5c564c;
    font-size: 13px;
}

QLabel#CardTitle {
    font-weight: 600;
    color: #3d6b6e;
}

QFrame#InfoCard {
    background-color: #faf7f1;
    border: 1px solid #cfc4b4;
    border-radius: 6px;
}

QStatusBar {
    background-color: #e7dfd1;
    color: #3a3530;
}

QListView {
    background-color: #f3efe6;
    border: 1px solid #cfc4b4;
    border-radius: 6px;
    padding: 6px;
}

QSplitter::handle {
    background-color: #cfc4b4;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

QSplitter::handle:hover {
    background-color: #3d6b6e;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #d9d0c2;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #3d6b6e;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background-color: #1f2a2e;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #3d6b6e;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px 0;
}

QScrollBar::handle:vertical {
    background-color: #cfc4b4;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3d6b6e;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0 2px;
}

QScrollBar::handle:horizontal {
    background-color: #cfc4b4;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #3d6b6e;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
